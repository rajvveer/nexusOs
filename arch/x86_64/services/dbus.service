[Unit]
Description=D-Bus System Message Bus
ConditionFileIsExecutable=/usr/bin/dbus-daemon
ConditionPathExists=/usr/share/dbus-1/system.conf

[Service]
ExecStartPre=/usr/bin/dbus-uuidgen --ensure=/etc/machine-id
ExecStartPre=/usr/bin/dbus-uuidgen --ensure
ExecStart=/usr/bin/dbus-daemon --system --address=unix:path=/run/dbus/system_bus_socket --nofork --nopidfile --nosyslog
ExecReload=/usr/bin/dbus-send --print-reply --system --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig
RuntimeDirectory=dbus
ReadyPath=/run/dbus/system_bus_socket
Restart=on-failure

[Install]
WantedBy=multi-user
DefaultEnabled=yes
