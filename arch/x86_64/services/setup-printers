#!/bin/sh
# NexusOS: create the "PDF" print queue (cups-pdf: printed documents become PDF files in ~/PDF of the user who printed)
# and make it the default destination when no other default exists. Run once by nexus-printers.service.
set -e
for i in $(seq 1 60); do lpstat -r >/dev/null 2>&1 && break; sleep 0.5; done
lpstat -r >/dev/null 2>&1 || { echo "setup-printers: the CUPS scheduler is not running" >&2; exit 1; }
ppd=/usr/share/ppd/cups-pdf/CUPS-PDF_opt.ppd
[ -e "$ppd" ] || ppd=/usr/share/ppd/cups-pdf/CUPS-PDF_noopt.ppd
if ! lpstat -v PDF >/dev/null 2>&1; then
    lpadmin -p PDF -D "Print to PDF" -L "NexusOS" -v cups-pdf:/ -P "$ppd" -o printer-is-shared=false -E
    echo "setup-printers: created queue PDF ($ppd)"
fi
if ! lpstat -d 2>/dev/null | grep -q "system default destination: "; then
    lpadmin -d PDF
    echo "setup-printers: PDF is the default destination"
fi
mkdir -p /var/lib/nexus
date -u +%Y-%m-%dT%H:%M:%SZ > /var/lib/nexus/printers.done
